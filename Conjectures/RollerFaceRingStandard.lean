import Conjectures.RollerIdealBasis
import Conjectures.RollerIdealPieces
import Conjectures.RollerComplex

/-! The shifted idealization of a pure squarefree face algebra is generated by
its degree-one elements. Primal faces factor into vertices and a dual face is
obtained by removing vertices from a containing facet. -/
noncomputable section
open scoped Classical
open RollerFaceRing

namespace RollerIdealGrading

variable {V : Type*} [Fintype V] (K : Type*) [Field K] (C : Complex V)

private theorem primal_in_adjoin (d : ℕ) (s : Finset V) (hs : C.face s) :
    primal K C ⟨s,hs⟩ ∈ Algebra.adjoin K (piece K C d 1 : Set (A K C)) := by
  induction s using Finset.induction_on with
  | empty => exact (primal_empty K C).symm ▸ Subalgebra.one_mem _
  | insert v s hv ih =>
    let a : Face C := ⟨{v},C.downward (Finset.singleton_subset_iff.mpr (Finset.mem_insert_self v s)) hs⟩
    let b : Face C := ⟨s,C.downward (Finset.subset_insert v s) hs⟩
    have ha : primal K C a ∈ Algebra.adjoin K (piece K C d 1 : Set (A K C)) :=
      Algebra.subset_adjoin (by simpa [a] using primal_mem K C d a)
    have hh := (Algebra.adjoin K (piece K C d 1 : Set (A K C))).mul_mem ha (ih b.property)
    have hn : Disjoint a.val b.val ∧ C.face (a.val ∪ b.val) := by simp [a,b,hv,hs,← Finset.insert_eq]
    change primal K C a * primal K C b ∈ _ at hh
    rw [primal_mul_primal,dif_pos hn] at hh
    simpa [a,b,← Finset.insert_eq] using hh

/-- Purity supplies degree-one dual facet generators. -/
theorem adjoin_degree_one_eq_top (d : ℕ)
    (pure : ∀ s : Face C, ∃ t : Face C, s.val ⊆ t.val ∧ t.val.card+1=d) :
    Algebra.adjoin K (piece K C d 1 : Set (A K C)) = ⊤ := by
  let L := Algebra.adjoin K (piece K C d 1 : Set (A K C))
  have hd (s : Face C) : dual K C s ∈ L := by
    obtain ⟨t,hst,ht⟩ := pure s
    let u : Face C := ⟨t.val \ s.val,C.downward Finset.sdiff_subset t.property⟩
    have h := L.mul_mem (primal_in_adjoin K C d u.val u.property)
      (Algebra.subset_adjoin (dual_mem K C t ht))
    have hu : u.val ⊆ t.val := Finset.sdiff_subset
    rw [primal_mul_dual,dif_pos hu] at h
    have eq : (⟨t.val \ u.val, C.downward Finset.sdiff_subset t.property⟩ : Face C) = s :=
      Subtype.ext (Finset.sdiff_sdiff_eq_self hst)
    rwa [eq] at h
  have htop : (⊤ : Submodule K (A K C)) ≤ L.toSubmodule := by
    rw [← (idealBasis K C).span_eq]
    apply Submodule.span_le.mpr
    rintro _ ⟨i,rfl⟩
    cases i with
    | inl s => exact (idealBasis_inl K C s).symm ▸ primal_in_adjoin K C d s.val s.property
    | inr s => exact (idealBasis_inr K C s).symm ▸ hd s
  exact top_unique (fun x _ => htop (Submodule.mem_top : x ∈ ⊤))

/-- In the actual colored whiskerings every face extends to a size-p completion. -/
theorem whiskered_standard {p : ℕ} {bs : List RollerRealization.Block}
    (h : ∀ b ∈ bs, RollerRealization.Admissible p b) :
    Algebra.adjoin K (piece K (RollerVertices.complex h) (p+1) 1 :
      Set (A K (RollerVertices.complex h))) = ⊤ := by
  apply adjoin_degree_one_eq_top
  intro s
  obtain ⟨t,ht,hs⟩ := (RollerShelling.face_iff_subset_completion (RollerVertices.color h) _
    (RollerVertices.old_down h) s.val).mp s.property
  let T := RollerShelling.completion (RollerVertices.color h) t
  have hT : (RollerVertices.complex h).face T := by
    change RollerShelling.Face (RollerVertices.color h) (RollerVertices.Old h) _
    simp [T,RollerShelling.Face,ht]
  exact ⟨⟨T,hT⟩,hs,by simp [T,RollerShelling.card_completion _ t ht.2]⟩

end RollerIdealGrading
