import Conjectures.RollerGorenstein
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! The annihilator of the augmented maximal ideal in a dual idealization. -/
namespace RollerGorenstein

noncomputable section

variable {K B : Type*} [Field K] [CommRing B] [Algebra K B]

/-- The augmentation kills the square-zero summand. -/
def augmentation (ε : B →ₐ[K] K) : Idealization K B →ₐ[K] K := ε.comp (projection K B)

/-- The socle generator is the base augmentation, regarded as a dual vector. -/
def socleGenerator (ε : B →ₐ[K] K) : Idealization K B := (0,ε.toLinearMap)

/-- Even before assuming locality, the annihilator of the augmentation kernel is
exactly the line generated by the augmentation functional in the dual summand. -/
theorem augmentation_annihilator (ε : B →ₐ[K] K) :
    ((RingHom.ker (augmentation ε)).annihilator).restrictScalars K =
      Submodule.span K {socleGenerator ε} := by
  ext x
  change x ∈ (RingHom.ker (augmentation ε)).annihilator ↔ _
  rw [Submodule.mem_annihilator, Submodule.mem_span_singleton]
  constructor
  · intro hx
    have hz (b : B) (f : Module.Dual K B) (h : ε b = 0) :
        f x.1 + x.2 b = 0 := by
      let y : Idealization K B := (b,f)
      have he := hx y (show ε b = 0 from h)
      have hh := congrArg (trace K B) he
      change trace K B (x*y) = trace K B 0 at hh
      simpa [trace_mul,y] using hh
    have hf : x.1=0 := (Module.forall_dual_apply_eq_zero_iff K x.1).1 fun f => by
      simpa using hz 0 f (map_zero ε)
    refine ⟨x.2 1,Prod.ext (by change x.2 1 • (0:B) = x.1; simpa using hf.symm) ?_⟩
    apply LinearMap.ext
    intro b
    have h := hz (b-ε b • (1:B)) 0 (by simp)
    change x.2 1 * ε b = x.2 b
    have h' : x.2 b - ε b * x.2 1 = 0 := by simpa using h
    exact (mul_comm _ _).trans (sub_eq_zero.mp h').symm
  · rintro ⟨s,rfl⟩ y hy
    change ε y.1=0 at hy
    change (s • socleGenerator ε)*y=0
    apply Prod.ext
    · change (s • (0:B))*y.1=0
      simp
    · apply LinearMap.ext
      intro b
      rw [mul_snd]
      change y.2 ((s • (0:B))*b) + s*ε (y.1*b) = 0
      simp [hy]

theorem socleGenerator_ne_zero (ε : B →ₐ[K] K) : socleGenerator ε ≠ 0 := by
  intro h
  have e := congrArg (trace K B) h
  exact one_ne_zero ((map_one ε).symm.trans e)

theorem finrank_augmentation_annihilator (ε : B →ₐ[K] K) :
    Module.finrank K (((RingHom.ker (augmentation ε)).annihilator).restrictScalars K) = 1 := by
  rw [augmentation_annihilator]
  exact finrank_span_singleton (socleGenerator_ne_zero ε)

/-- For a local base the canonical residue map identifies the ideal used above
with the unique maximal ideal of the idealization. -/
theorem augmentation_kernel_eq_maximal [IsLocalRing B] (ε : B →ₐ[K] K) :
    RingHom.ker (augmentation ε) = IsLocalRing.maximalIdeal (Idealization K B) := by
  apply IsLocalRing.eq_maximalIdeal
  apply RingHom.ker_isMaximal_of_surjective (augmentation ε)
  exact fun t => ⟨algebraMap K _ t,(augmentation ε).commutes t⟩

/-- As a K-algebra, the residue field of the idealization is the ground field. -/
def residueEquiv [IsLocalRing B] (ε : B →ₐ[K] K) :
    (Idealization K B ⧸ IsLocalRing.maximalIdeal (Idealization K B)) ≃ₐ[K] K := by
  rw [← augmentation_kernel_eq_maximal ε]
  exact Ideal.quotientKerAlgEquivOfRightInverse (f:=augmentation ε)
    (g:=algebraMap K _) (augmentation ε).commutes

/-- A commutative zero-dimensional local ring is Gorenstein exactly when its
socle is a line over its residue field. Here the residue field is K. -/
theorem finrank_socle [IsLocalRing B] (ε : B →ₐ[K] K) :
    Module.finrank K (((IsLocalRing.maximalIdeal (Idealization K B)).annihilator).restrictScalars K) = 1 := by
  rw [← augmentation_kernel_eq_maximal ε]
  exact finrank_augmentation_annihilator ε

end
end RollerGorenstein
